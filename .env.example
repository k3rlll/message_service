# Скопируйте этот файл в .env и задайте свои значения.
# Сам .env в git не попадает.

ENVIRONMENT=development

# Публичный ключ сервиса авторизации (RS256).
# Для локальной разработки пару ключей создает: go run ./cmd/devtoken
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

SERVER_PORT=8080
SERVER_HOST=0.0.0.0

REDIS_ADDR=localhost:6379
REDIS_CLIENT_NAME=message_service
REDIS_PASSWORD=change-me

MONGO_PORT=27017
MONGO_HOST=localhost
MONGO_DATABASE=message_service_db
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me
MONGO_URI=mongodb://${MONGO_USERNAME}:${MONGO_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}

# S3-совместимое хранилище вложений (в compose - RustFS).
# Если S3_ENDPOINT не задан, вложения отключены.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=change-me
S3_BUCKET=attachments
